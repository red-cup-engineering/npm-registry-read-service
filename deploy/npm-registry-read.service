[Unit]
Description=Read-only immutable npm registry face
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/red-cup/npm-registry/read-service/@red-cup-engineering/npm-registry-read-service-1.0.1
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node scripts/serve-npm-registry-read.mjs --registry /srv/red-cup/npm-registry/host/current --host 127.0.0.1 --port 4873
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/srv/red-cup/npm-registry/host

[Install]
WantedBy=default.target
